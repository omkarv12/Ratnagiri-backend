# ==================================================================
# Admin analytics (one call powers the whole analytics dashboard)
# ==================================================================

def _rows(sql, params=None):
    """Run a query and return list[dict]; a failing query never breaks the rest."""
    try:
        res = db.session.execute(text(sql), params or {}).mappings().all()
        return [dict(r) for r in res]
    except Exception as e:
        print("ROWS ERROR:", e)
        db.session.rollback()
        return []


def _scalar(sql, params=None):
    try:
        return db.session.execute(text(sql), params or {}).scalar() or 0
    except Exception:
        db.session.rollback()
        return 0


def _one(sql):
    rows = _rows(sql)
    return rows[0] if rows else {}


def _group(table, column, fallback="Other", where="", limit=None):
    """COUNT(*) grouped by one column -> [{label, value}]. Arguments are fixed
    strings written in this file, never request input."""
    sql = (
        f"SELECT COALESCE(NULLIF({column}::text, ''), '{fallback}') AS label, "
        f"COUNT(*) AS value FROM {table} {where} GROUP BY 1 ORDER BY value DESC, label"
    )
    if limit:
        sql += f" LIMIT {int(limit)}"
    return _rows(sql)


def _yes(column):
    """SQL fragment: true when a text / boolean column means 'yes'."""
    return f"COALESCE(({column})::text, '') ~* '^(y|yes|true|t|1)'"


@bp.route('/api/admin/analytics', methods=['GET'])
def admin_analytics():
    try:
        # ---------------- totals & pending ----------------
        totals = {
            "locations": _scalar("SELECT COUNT(*) FROM locations"),
            "homestays": _scalar("SELECT COUNT(*) FROM homestays"),
            "drivers": _scalar("SELECT COUNT(*) FROM drivers"),
            "bus_stops": _scalar("SELECT COUNT(*) FROM bus_stops"),
            "eco_water": _scalar("SELECT COUNT(*) FROM eco_and_water"),
            "village_profiles": _scalar("SELECT COUNT(*) FROM village_profiles"),
            "stories_published": _scalar("SELECT COUNT(*) FROM blogs WHERE status = 'published'"),
            "events_approved": _scalar("SELECT COUNT(*) FROM tourism_events WHERE status = 'approved'"),
            # new
            "atms": _scalar("SELECT COUNT(*) FROM atms"),
            "medical_facilities": _scalar("SELECT COUNT(*) FROM medical_facilities WHERE is_active"),
            "police_stations": _scalar("SELECT COUNT(*) FROM police_stations WHERE is_active"),
            "hidden_paths": _scalar("SELECT COUNT(*) FROM hidden_paths WHERE status = 'approved'"),
            "itineraries": _scalar("SELECT COUNT(*) FROM itineraries WHERE status = 'published'"),
            "circuits": _scalar("SELECT COUNT(*) FROM circuits WHERE status = 'published'"),
            "explore_villages": _scalar("SELECT COUNT(*) FROM village_explore WHERE status = 'published'"),
            "experiences": _scalar("SELECT COUNT(*) FROM experiences WHERE status = 'published'"),
        }

        pending = {
            "locations": _scalar("SELECT COUNT(*) FROM pending_locations"),
            "homestays": _scalar("SELECT COUNT(*) FROM pending_homestays"),
            "drivers": _scalar("SELECT COUNT(*) FROM pending_drivers"),
            "events": _scalar("SELECT COUNT(*) FROM tourism_events WHERE status = 'pending'"),
            "hidden_paths": _scalar("SELECT COUNT(*) FROM hidden_paths WHERE status = 'pending'"),
        }

        # How long have people been waiting? (days)
        pending_union = """
            SELECT submitted_at AS t FROM pending_locations
            UNION ALL SELECT submitted_at FROM pending_homestays
            UNION ALL SELECT submitted_at FROM pending_drivers
            UNION ALL SELECT created_at FROM tourism_events WHERE status = 'pending'
            UNION ALL SELECT created_at FROM hidden_paths WHERE status = 'pending'
        """
        pending_age = {
            "oldest_days": int(_scalar(
                f"SELECT COALESCE(MAX(EXTRACT(EPOCH FROM (NOW() - t)) / 86400), 0) FROM ({pending_union}) x"
            ) or 0),
            "over_7_days": int(_scalar(
                f"SELECT COUNT(*) FROM ({pending_union}) x WHERE t < NOW() - interval '7 days'"
            ) or 0),
        }

        # ---------------- coverage (existing) ----------------
        locations_by_taluka = _rows("""
            SELECT COALESCE(NULLIF(taluka_name, ''), 'Unknown') AS label, COUNT(*) AS value
            FROM locations GROUP BY 1 ORDER BY value DESC
        """)
        homestays_by_taluka = _rows("""
            SELECT COALESCE(NULLIF(taluka_name, ''), 'Unknown') AS label, COUNT(*) AS value
            FROM homestays GROUP BY 1 ORDER BY value DESC
        """)
        locations_by_type = _group("locations", "attraction_type")
        homestays_by_type = _group("homestays", "homestay_type")
        road_condition = _group("locations", "road_condition", "Not stated")

        location_readiness = _one("""
            SELECT COUNT(*) AS total,
                   COUNT(*) FILTER (
                       WHERE COALESCE(site_photos::text, '') NOT IN ('', '{}', '[]')
                   ) AS with_photos,
                   COUNT(*) FILTER (
                       WHERE latitude IS NOT NULL AND longitude IS NOT NULL
                   ) AS with_coordinates,
                   COUNT(*) FILTER (
                       WHERE signboards_available::text ILIKE 'y%'
                   ) AS with_signboards
            FROM locations
        """)

        homestay_readiness = _one("""
            SELECT COUNT(*) AS total,
                   COUNT(*) FILTER (WHERE registered_mtdc::text ILIKE 'y%') AS mtdc_registered,
                   COUNT(*) FILTER (
                       WHERE digital_payments_upi::text ILIKE 'y%'
                          OR digital_payments_upi::text ILIKE '%upi%'
                   ) AS digital_payments,
                   COUNT(*) FILTER (WHERE listed_booking_airbnb::text ILIKE 'y%') AS listed_online
            FROM homestays
        """)

        # ---------------- coverage (new) ----------------
        locations_by_village = _rows("""
            SELECT l.village_name || ' (' || COALESCE(NULLIF(l.taluka_name, ''), '?') || ')' AS label,
                   COUNT(*) AS value
            FROM locations l
            WHERE COALESCE(trim(l.village_name), '') <> ''
            GROUP BY l.village_name, l.taluka_name
            ORDER BY value DESC, label
            LIMIT 10
        """)

        location_facilities = _one(f"""
            SELECT COUNT(*) AS total,
                   COUNT(*) FILTER (WHERE {_yes('parking_space')}) AS parking,
                   COUNT(*) FILTER (WHERE {_yes('food_stalls')}) AS food_stalls,
                   COUNT(*) FILTER (WHERE {_yes('public_transport')}) AS public_transport,
                   COUNT(*) FILTER (
                       WHERE COALESCE(entry_fee::text, '') ~* '^(n|no|free|false|f|0)'
                   ) AS free_entry
            FROM locations
        """)
        locations_by_crowd = _group("locations", "crowd_level", "Not stated")
        locations_by_season = _group("locations", "seasonal_availability", "Not stated", limit=8)

        homestay_facilities = _one(f"""
            SELECT COUNT(*) AS total,
                   COUNT(*) FILTER (WHERE {_yes('veg_meals')}) AS veg_meals,
                   COUNT(*) FILTER (WHERE {_yes('guides_available')}) AS guides,
                   COUNT(*) FILTER (WHERE {_yes('live_on_premises')}) AS host_on_site,
                   COUNT(*) FILTER (WHERE {_yes('discoverable_google_map')}) AS on_google_maps,
                   COUNT(*) FILTER (
                       WHERE COALESCE(trim(social_media_page), '') <> ''
                   ) AS social_media
            FROM homestays
        """)

        # ---------------- services & infrastructure ----------------
        drivers_by_taluka = _group("drivers", "taluka_name", "Unknown")
        drivers_by_vehicle = _group("drivers", "vehicle_type", "Other")
        bus_stops_by_taluka = _group("bus_stops", "taluka_name", "Unknown")

        atms = {
            "total": totals["atms"],
            "open_24x7": _scalar("SELECT COUNT(*) FROM atms WHERE is_24x7"),
            "cash_deposit": _scalar("SELECT COUNT(*) FROM atms WHERE has_cash_deposit"),
            "by_bank": _group("atms", "bank_name", "Unknown", limit=8),
            "by_taluka": _group("atms", "taluka_name", "Unknown"),
        }

        health_services = {
            "medical_by_category": _group("medical_facilities", "category", "Other", where="WHERE is_active"),
            "medical_24x7": _scalar("SELECT COUNT(*) FROM medical_facilities WHERE is_active AND is_24x7"),
            "medical_with_emergency": _scalar(
                "SELECT COUNT(*) FROM medical_facilities WHERE is_active AND emergency_available"),
            "police_by_category": _group("police_stations", "category", "Other", where="WHERE is_active"),
            "police_tourist_help": _scalar("SELECT COUNT(*) FROM police_stations WHERE is_active AND tourist_help"),
        }

        # ---------------- content library ----------------
        content = {
            "itineraries": {
                "published": totals["itineraries"],
                "drafts": _scalar("SELECT COUNT(*) FROM itineraries WHERE status <> 'published'"),
            },
            "circuits": {
                "published": totals["circuits"],
                "drafts": _scalar("SELECT COUNT(*) FROM circuits WHERE status <> 'published'"),
            },
            "explore_villages": {
                "published": totals["explore_villages"],
                "drafts": _scalar("SELECT COUNT(*) FROM village_explore WHERE status <> 'published'"),
            },
            "experiences_by_category": _group(
                "experiences", "category", "Other", where="WHERE status = 'published'"),
            "experiences_drafts": _scalar("SELECT COUNT(*) FROM experiences WHERE status <> 'published'"),
        }

        hidden_paths = {
            "by_status": _group("hidden_paths", "status", "unknown"),
            "by_type": _group("hidden_paths", "path_type", "Other", where="WHERE status = 'approved'"),
            "by_difficulty": _group("hidden_paths", "difficulty", "Other", where="WHERE status = 'approved'"),
            "total_km": float(_scalar(
                "SELECT COALESCE(SUM(length_km), 0) FROM hidden_paths WHERE status = 'approved'") or 0),
        }

        # ---------------- events ----------------
        events_by_month = _rows("""
            SELECT to_char(g.m, 'Mon') AS label, COUNT(e.id) AS value
            FROM generate_series(
                date_trunc('month', CURRENT_DATE),
                date_trunc('month', CURRENT_DATE) + interval '5 months',
                interval '1 month'
            ) AS g(m)
            LEFT JOIN tourism_events e
                   ON date_trunc('month', e.event_date) = g.m
                  AND e.status = 'approved'
            GROUP BY g.m ORDER BY g.m
        """)
        events_by_category = _rows("""
            SELECT category AS label, COUNT(*) AS value
            FROM tourism_events WHERE status = 'approved'
            GROUP BY category ORDER BY value DESC
        """)
        events_summary = {
            "upcoming_30_days": _scalar("""
                SELECT COUNT(*) FROM tourism_events
                WHERE status = 'approved'
                  AND event_date >= CURRENT_DATE AND event_date < CURRENT_DATE + 30
            """),
            "past": _scalar("""
                SELECT COUNT(*) FROM tourism_events
                WHERE status = 'approved' AND event_date < CURRENT_DATE
            """),
            "pending": pending["events"],
        }

        # ---------------- stories ----------------
        stories = {
            "published": totals["stories_published"],
            "drafts": _scalar("SELECT COUNT(*) FROM blogs WHERE status <> 'published'"),
            "total_views": _scalar("SELECT COALESCE(SUM(views), 0) FROM blogs WHERE status = 'published'"),
            "comments": _scalar("SELECT COUNT(*) FROM blog_comments"),
            "top": _rows("""
                SELECT title AS label, COALESCE(views, 0) AS value
                FROM blogs WHERE status = 'published'
                ORDER BY views DESC NULLS LAST LIMIT 5
            """),
            # new
            "by_category": _rows("""
                SELECT COALESCE(c.name, 'Uncategorised') AS label, COUNT(b.id) AS value
                FROM blogs b LEFT JOIN blog_categories c ON c.id = b.category_id
                WHERE b.status = 'published'
                GROUP BY 1 ORDER BY value DESC
            """),
            "published_by_month": _rows("""
                SELECT to_char(g.m, 'Mon') AS label, COUNT(b.id) AS value
                FROM generate_series(
                    date_trunc('month', CURRENT_DATE) - interval '5 months',
                    date_trunc('month', CURRENT_DATE),
                    interval '1 month'
                ) AS g(m)
                LEFT JOIN blogs b
                       ON date_trunc('month', b.published_at) = g.m
                      AND b.status = 'published'
                GROUP BY g.m ORDER BY g.m
            """),
        }

        # ---------------- gaps: concrete things to fix ----------------
        villages_without_page = _rows("""
            SELECT l.village_name AS village,
                   COALESCE(NULLIF(l.taluka_name, ''), 'Unknown') AS taluka,
                   COUNT(*) AS places
            FROM locations l
            LEFT JOIN village_explore v
                   ON lower(trim(v.village_name)) = lower(trim(l.village_name))
                  AND lower(trim(v.taluka_name)) = lower(trim(l.taluka_name))
                  AND v.status = 'published'
            WHERE COALESCE(trim(l.village_name), '') <> '' AND v.id IS NULL
            GROUP BY l.village_name, l.taluka_name
            ORDER BY places DESC, village
        """)
        villages_total = _scalar("""
            SELECT COUNT(*) FROM (
                SELECT DISTINCT lower(trim(village_name)), lower(trim(taluka_name))
                FROM locations WHERE COALESCE(trim(village_name), '') <> ''
            ) x
        """)

        gaps = {
            "villages_total": villages_total,
            "villages_without_page": len(villages_without_page),
            "villages_without_page_list": villages_without_page[:10],
            "locations_without_photos": _rows("""
                SELECT location_name AS label,
                       COALESCE(NULLIF(taluka_name, ''), 'Unknown') AS area
                FROM locations
                WHERE COALESCE(site_photos::text, '') IN ('', '{}', '[]')
                ORDER BY location_name LIMIT 10
            """),
            "locations_without_coordinates": _rows("""
                SELECT location_name AS label,
                       COALESCE(NULLIF(taluka_name, ''), 'Unknown') AS area
                FROM locations
                WHERE latitude IS NULL OR longitude IS NULL
                ORDER BY location_name LIMIT 10
            """),
            "homestays_without_digital_payment": _rows("""
                SELECT homestay_name AS label,
                       COALESCE(NULLIF(taluka_name, ''), 'Unknown') AS area
                FROM homestays
                WHERE NOT (digital_payments_upi::text ILIKE 'y%'
                           OR digital_payments_upi::text ILIKE '%upi%')
                   OR digital_payments_upi IS NULL
                ORDER BY homestay_name LIMIT 10
            """),
        }

        return jsonify({
            "generated_at": datetime.utcnow().isoformat() + "Z",
            # existing keys (unchanged)
            "totals": totals,
            "pending": pending,
            "locations_by_taluka": locations_by_taluka,
            "homestays_by_taluka": homestays_by_taluka,
            "locations_by_type": locations_by_type,
            "homestays_by_type": homestays_by_type,
            "road_condition": road_condition,
            "location_readiness": location_readiness,
            "homestay_readiness": homestay_readiness,
            "events_by_month": events_by_month,
            "events_by_category": events_by_category,
            "stories": stories,
            # new keys
            "pending_age": pending_age,
            "locations_by_village": locations_by_village,
            "location_facilities": location_facilities,
            "locations_by_crowd": locations_by_crowd,
            "locations_by_season": locations_by_season,
            "homestay_facilities": homestay_facilities,
            "drivers_by_taluka": drivers_by_taluka,
            "drivers_by_vehicle": drivers_by_vehicle,
            "bus_stops_by_taluka": bus_stops_by_taluka,
            "atms": atms,
            "health_services": health_services,
            "content": content,
            "hidden_paths": hidden_paths,
            "events_summary": events_summary,
            "gaps": gaps,
        }), 200

    except Exception as e:
        db.session.rollback()
        return jsonify({"error": str(e)}), 500


@bp.route('/api/upload-photo', methods=['POST'])
def upload_photo():
    try:
        if 'photo' not in request.files:
            return jsonify({"success": False, "error": "No file provided"}), 400

        file = request.files['photo']
        result = cloudinary.uploader.upload(file)

        return jsonify({
            "success": True,
            "url": result['secure_url']
        }), 200

    except Exception as e:
        return jsonify({"success": False, "error": str(e)}), 500


# ==================================================================
# Medical facilities  (NEW)
# Requires medical_facilities.sql to have been run on the database first.
# ==================================================================

@bp.route('/api/medical-facilities', methods=['GET'])
def list_medical_facilities():
    """
    Optional query params:
      category   hospital | clinic | diagnostic | pharmacy | blood_bank | ambulance
      specialty  exact specialty text
      lat, lng   visitor position; adds distance_km and sorts nearest first
    """
    try:
        params = {
            "category": request.args.get("category") or None,
            "specialty": request.args.get("specialty") or None,
            "lat": request.args.get("lat", type=float),
            "lng": request.args.get("lng", type=float),
        }

        rows = db.session.execute(text("""
            SELECT
                f.id, f.slug, f.name, f.name_mr, f.category, f.specialty, f.ownership,
                f.description, f.features,
                f.address_line AS address, f.landmark, f.area, f.taluka, f.district,
                f.state, f.pincode,
                f.lat::float8 AS lat, f.lng::float8 AS lng, f.map_url,
                f.phone_primary AS phone, f.phone_secondary, f.emergency_phone,
                f.whatsapp, f.email, f.website,
                f.opening_hours_note, f.is_24x7, f.emergency_available,
                f.ambulance_available, f.icu_available, f.bed_count,
                f.appointment_required, f.walk_in_allowed, f.teleconsultation,
                f.home_service, f.wheelchair_accessible, f.hearing_loop,
                f.parking_available, f.accepts_upi, f.accepts_cards,
                f.cashless_insurance, f.govt_schemes, f.is_free,
                f.consultation_fee_min::float8 AS consultation_fee_min,
                f.consultation_fee_max::float8 AS consultation_fee_max,
                f.languages, f.registration_no, f.accreditations, f.cover_image_url,
                f.rating_avg::float8 AS rating_avg, f.rating_count,
                f.is_verified, f.last_verified::text AS last_verified,

                COALESCE((
                    SELECT json_agg(json_build_object(
                               'day', h.day_of_week,
                               'opens', to_char(h.opens, 'HH24:MI'),
                               'closes', to_char(h.closes, 'HH24:MI'),
                               'is_24h', h.is_24h,
                               'is_closed', h.is_closed)
                           ORDER BY h.day_of_week, h.opens)
                    FROM facility_hours h WHERE h.facility_id = f.id
                ), '[]'::json) AS hours,

                COALESCE((
                    SELECT json_agg(json_build_object(
                               'name', s.name, 'department', s.department, 'notes', s.notes)
                           ORDER BY s.sort_order, s.name)
                    FROM facility_services s WHERE s.facility_id = f.id
                ), '[]'::json) AS services,

                COALESCE((
                    SELECT json_agg(json_build_object(
                               'name', d.full_name, 'qualification', d.qualification,
                               'specialization', d.specialization,
                               'experience_years', d.experience_years,
                               'available_days', d.available_days,
                               'timing', d.timing_note,
                               'fee', d.consultation_fee::float8)
                           ORDER BY d.full_name)
                    FROM facility_doctors d WHERE d.facility_id = f.id AND d.is_active
                ), '[]'::json) AS doctors,

                COALESCE((
                    SELECT json_agg(json_build_object(
                               'url', i.url, 'caption', i.caption, 'is_cover', i.is_cover)
                           ORDER BY i.sort_order)
                    FROM facility_images i WHERE i.facility_id = f.id
                ), '[]'::json) AS images,

                haversine_km(CAST(:lat AS float8), CAST(:lng AS float8),
                             f.lat::float8, f.lng::float8) AS distance_km
            FROM medical_facilities f
            WHERE f.is_active
              AND (CAST(:category AS text) IS NULL OR f.category = CAST(:category AS text))
              AND (CAST(:specialty AS text) IS NULL OR f.specialty = CAST(:specialty AS text))
            ORDER BY distance_km NULLS LAST, f.name
        """), params).mappings().all()

        return jsonify([dict(row) for row in rows]), 200

    except Exception as e:
        db.session.rollback()
        return jsonify({"error": str(e)}), 500


# ==================================================================
# Police stations  (NEW)
# Requires police_stations.sql to have been run on the database first.
# ==================================================================

@bp.route('/api/police-stations', methods=['GET'])
def list_police_stations():
    """
    Optional query params:
      category   station | district_office | cyber | headquarters |
                 women_cell | traffic | outpost
      lat, lng   visitor position; adds distance_km and sorts nearest first
    """
    try:
        params = {
            "category": request.args.get("category") or None,
            "lat": request.args.get("lat", type=float),
            "lng": request.args.get("lng", type=float),
        }

        rows = db.session.execute(text("""
            SELECT
                p.id, p.slug, p.name, p.name_mr, p.category, p.unit_type,
                p.description, p.features, p.jurisdiction,
                p.address_line AS address, p.landmark, p.area, p.taluka, p.district,
                p.state, p.pincode,
                p.lat::float8 AS lat, p.lng::float8 AS lng, p.map_url,
                p.phone_primary AS phone, p.phone_secondary, p.emergency_phone,
                p.whatsapp, p.email, p.website, p.online_complaint_url,
                p.opening_hours_note, p.is_24x7, p.files_fir, p.online_complaints,
                p.women_help_desk, p.tourist_help, p.lost_property_reports,
                p.wheelchair_accessible, p.accessible_restrooms, p.parking_available,
                p.languages, p.cover_image_url,
                p.is_verified, p.last_verified::text AS last_verified,

                COALESCE((
                    SELECT json_agg(json_build_object(
                               'day', h.day_of_week,
                               'opens', to_char(h.opens, 'HH24:MI'),
                               'closes', to_char(h.closes, 'HH24:MI'),
                               'is_24h', h.is_24h,
                               'is_closed', h.is_closed)
                           ORDER BY h.day_of_week, h.opens)
                    FROM police_station_hours h WHERE h.station_id = p.id
                ), '[]'::json) AS hours,

                COALESCE((
                    SELECT json_agg(json_build_object(
                               'name', s.name, 'notes', s.notes)
                           ORDER BY s.sort_order, s.name)
                    FROM police_station_services s WHERE s.station_id = p.id
                ), '[]'::json) AS services,

                COALESCE((
                    SELECT json_agg(json_build_object(
                               'url', i.url, 'caption', i.caption, 'is_cover', i.is_cover)
                           ORDER BY i.sort_order)
                    FROM police_station_images i WHERE i.station_id = p.id
                ), '[]'::json) AS images,

                haversine_km(CAST(:lat AS float8), CAST(:lng AS float8),
                             p.lat::float8, p.lng::float8) AS distance_km
            FROM police_stations p
            WHERE p.is_active
              AND (CAST(:category AS text) IS NULL OR p.category = CAST(:category AS text))
            ORDER BY distance_km NULLS LAST, p.name
        """), params).mappings().all()

        return jsonify([dict(row) for row in rows]), 200

    except Exception as e:
        db.session.rollback()
        return jsonify({"error": str(e)}), 500


# ==================================================================
# ATMs
# Requires atms.sql to have been run on the database first.
# ==================================================================

@bp.route('/api/atms/register', methods=['POST'])
def register_atm():
    try:
        data = request.get_json() or {}

        atm_name = (data.get("atm_name") or "").strip()
        bank_name = (data.get("bank_name") or "").strip()
        if not atm_name or not bank_name:
            return jsonify({"success": False, "error": "ATM name and bank are required."}), 400

        google_maps_link = data.get("google_maps_link")
        latitude, longitude = _resolve_coordinates(data, google_maps_link)
        if latitude is None or longitude is None:
            return jsonify({"success": False, "error": "Location coordinates are required."}), 400

        photo_url = (data.get("photo_url") or "").strip() or None
        if photo_url and not photo_url.startswith("https://"):
            return jsonify({"success": False, "error": "Invalid photo URL"}), 400

        db.session.execute(text("""
            INSERT INTO atms (
                atm_name, bank_name, village_name, taluka_name, district_name,
                address, google_maps_link, latitude, longitude,
                is_24x7, has_cash_deposit, photo_url
            )
            VALUES (
                :atm_name, :bank_name, :village_name, :taluka_name, :district_name,
                :address, :google_maps_link, :latitude, :longitude,
                :is_24x7, :has_cash_deposit, :photo_url
            )
        """), {
            "atm_name": atm_name[:200],
            "bank_name": bank_name[:150],
            "village_name": data.get("village_name"),
            "taluka_name": data.get("taluka_name"),
            "district_name": data.get("district_name", "Ratnagiri"),
            "address": data.get("address"),
            "google_maps_link": google_maps_link,
            "latitude": latitude,
            "longitude": longitude,
            "is_24x7": bool(data.get("is_24x7", True)),
            "has_cash_deposit": bool(data.get("has_cash_deposit", False)),
            "photo_url": photo_url,
        })
        db.session.commit()

        return jsonify({"success": True, "message": "ATM added successfully."}), 201

    except Exception as e:
        db.session.rollback()
        return jsonify({"success": False, "error": str(e)}), 500


@bp.route('/api/atms', methods=['GET'])
def get_atms():
    try:
        result = db.session.execute(text("""
            SELECT * FROM atms ORDER BY bank_name, atm_name
        """)).mappings().all()
        return jsonify([dict(row) for row in result]), 200
    except Exception as e:
        return jsonify({"error": str(e)}), 500


@bp.route('/api/atms/<int:id>', methods=['DELETE'])
def delete_atm(id):
    try:
        result = db.session.execute(text("DELETE FROM atms WHERE id = :id"), {"id": id})
        db.session.commit()
        if result.rowcount == 0:
            return jsonify({"success": False, "error": "ATM not found."}), 404
        return jsonify({"success": True, "message": "ATM deleted."}), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({"success": False, "error": str(e)}), 500


# ==================================================================
# Admin data manager: view / edit / delete / add live records
#
# Table names come from the fixed ADMIN_TABLES list and column names are
# checked against the real table columns, so nothing from the request is
# ever put into the SQL text.
# ==================================================================

ADMIN_TABLES = {
    "locations": "locations",
    "homestays": "homestays",
    "drivers": "drivers",
    "bus_stops": "bus_stops",
    "atms": "atms",
    "pending_locations": "pending_locations",
    "pending_homestays": "pending_homestays",
}

# Kinds that can be created from the admin panel, with their required fields.
ADMIN_CREATABLE = {
    "bus_stops": ("stop_name",),
    "atms": ("atm_name", "bank_name"),
}

_ADMIN_READONLY_COLUMNS = {
    "id", "created_at", "updated_at", "submitted_at", "reviewed_at",
    "reviewed_by", "approved_at",
}
_ADMIN_TIME_TYPES = {
    "timestamp without time zone", "timestamp with time zone", "date",
    "time without time zone", "time with time zone",
}
_ADMIN_NUMERIC_TYPES = {
    "integer", "bigint", "smallint", "numeric", "double precision", "real",
}


def _admin_table_columns(table):
    rows = db.session.execute(text("""
        SELECT column_name, data_type
        FROM information_schema.columns
        WHERE table_schema = current_schema() AND table_name = :t
        ORDER BY ordinal_position
    """), {"t": table}).all()
    return {r[0]: r[1] for r in rows}


def _admin_coerce(value, data_type):
    """Turn a value from the admin form into something the column accepts."""
    if data_type == "ARRAY":
        if isinstance(value, list):
            return value
        if value in (None, ""):
            return None
        return [p.strip() for p in str(value).split(",") if p.strip()]
    if data_type == "boolean":
        if isinstance(value, bool) or value is None:
            return value
        s = str(value).strip().lower()
        if s == "":
            return None
        return s in ("true", "t", "1", "yes", "y")
    if data_type in ("json", "jsonb"):
        if value in (None, ""):
            return None
        return value if isinstance(value, str) else json.dumps(value)
    if data_type in _ADMIN_NUMERIC_TYPES:
        return None if value in (None, "") else value
    return value


def _admin_check_coordinates(data):
    """Return an error message if latitude / longitude are present but invalid."""
    for key, low, high in (("latitude", -90, 90), ("longitude", -180, 180)):
        value = data.get(key)
        if value in (None, ""):
            continue
        try:
            number = float(value)
        except (TypeError, ValueError):
            return f"{key.capitalize()} must be a number."
        if not (low <= number <= high):
            return f"{key.capitalize()} is out of range."
    return None


def _admin_editable(cols, key):
    return (
        key in cols
        and key not in _ADMIN_READONLY_COLUMNS
        and cols[key] not in _ADMIN_TIME_TYPES
    )


@bp.route('/api/admin/data/<kind>', methods=['GET'])
def admin_data_list(kind):
    table = ADMIN_TABLES.get(kind)
    if not table:
        return jsonify({"error": "Unknown data type."}), 404
    try:
        rows = db.session.execute(
            text(f"SELECT * FROM {table} ORDER BY id DESC")
        ).mappings().all()
        return jsonify([dict(r) for r in rows]), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({"error": str(e)}), 500


@bp.route('/api/admin/data/<kind>/<int:id>', methods=['PUT'])
def admin_data_update(kind, id):
    table = ADMIN_TABLES.get(kind)
    if not table:
        return jsonify({"error": "Unknown data type."}), 404
    try:
        data = request.get_json(silent=True) or {}

        problem = _admin_check_coordinates(data)
        if problem:
            return jsonify({"success": False, "error": problem}), 400

        cols = _admin_table_columns(table)
        sets, params = [], {"id": id}
        for i, (key, value) in enumerate(data.items()):
            if not _admin_editable(cols, key):
                continue
            sets.append(f'"{key}" = :p{i}')
            params[f"p{i}"] = _admin_coerce(value, cols[key])

        if not sets:
            return jsonify({"success": False, "error": "Nothing to update."}), 400

        row = db.session.execute(
            text(f"UPDATE {table} SET {', '.join(sets)} WHERE id = :id RETURNING *"),
            params,
        ).mappings().first()

        if row is None:
            db.session.rollback()
            return jsonify({"success": False, "error": "Record not found."}), 404

        db.session.commit()
        return jsonify(dict(row)), 200

    except Exception as e:
        db.session.rollback()
        return jsonify({"success": False, "error": str(e)}), 500


@bp.route('/api/admin/data/<kind>/<int:id>', methods=['DELETE'])
def admin_data_delete(kind, id):
    table = ADMIN_TABLES.get(kind)
    if not table:
        return jsonify({"error": "Unknown data type."}), 404
    try:
        result = db.session.execute(text(f"DELETE FROM {table} WHERE id = :id"), {"id": id})
        db.session.commit()
        if result.rowcount == 0:
            return jsonify({"success": False, "error": "Record not found."}), 404
        return jsonify({"success": True, "message": "Deleted."}), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({"success": False, "error": str(e)}), 500


@bp.route('/api/admin/data/<kind>', methods=['POST'])
def admin_data_create(kind):
    table = ADMIN_TABLES.get(kind)
    required = ADMIN_CREATABLE.get(kind)
    if not table or required is None:
        return jsonify({"success": False, "error": "This type can't be added here."}), 400
    try:
        data = request.get_json(silent=True) or {}

        for field in required:
            if not str(data.get(field) or "").strip():
                return jsonify({"success": False, "error": f"{field.replace('_', ' ').capitalize()} is required."}), 400

        problem = _admin_check_coordinates(data)
        if problem:
            return jsonify({"success": False, "error": problem}), 400

        latitude, longitude = _resolve_coordinates(data, data.get("google_maps_link"))
        if latitude in (None, "") or longitude in (None, ""):
            return jsonify({"success": False, "error": "Location coordinates are required."}), 400
        data["latitude"], data["longitude"] = latitude, longitude

        data.setdefault("district_name", "Ratnagiri")
        if kind == "atms":
            data.setdefault("is_24x7", True)
            data.setdefault("has_cash_deposit", False)
            photo = (data.get("photo_url") or "").strip()
            if photo and not photo.startswith("https://"):
                return jsonify({"success": False, "error": "Photo URL must start with https://"}), 400

        cols = _admin_table_columns(table)
        column_parts, value_parts, params = [], [], {}
        for i, (key, value) in enumerate(data.items()):
            if not _admin_editable(cols, key):
                continue
            column_parts.append(f'"{key}"')
            value_parts.append(f":p{i}")
            params[f"p{i}"] = _admin_coerce(value, cols[key])

        columns_sql = ", ".join(column_parts)
        placeholders = ", ".join(value_parts)

        row = db.session.execute(
            text(f"INSERT INTO {table} ({columns_sql}) VALUES ({placeholders}) RETURNING *"),
            params,
        ).mappings().first()
        db.session.commit()

        return jsonify(dict(row)), 201

    except Exception as e:
        db.session.rollback()
        return jsonify({"success": False, "error": str(e)}), 500


# The Pending Submissions tab already calls these to save an edit, but the
# routes did not exist. They reuse the same updater and return the updated row.

@bp.route('/api/pending_locations/<int:id>', methods=['PUT'])
def update_pending_location(id):
    return admin_data_update("pending_locations", id)


@bp.route('/api/pending_homestays/<int:id>', methods=['PUT'])
def update_pending_homestay(id):
    return admin_data_update("pending_homestays", id)


# ---------------------------------------------------------------------------
# HIDDEN PATHS
#
# Photos are NOT handled here: the form uploads them through your existing
# /api/upload-photo and sends the returned Cloudinary URLs.
#
# Admin routes use `admin_required` (defined near the top of this file).
# It is a placeholder for now: replace it with a real admin check, and protect
# your pending_locations / events admin routes the same way.
# ---------------------------------------------------------------------------

PATH_STATUSES = ('pending', 'needs_changes', 'approved', 'rejected')
PATH_TYPES = ('Forest trail', 'Secret beach', 'Waterfall', 'Viewpoint', 'Village walk')
PATH_DIFFICULTIES = ('Easy', 'Moderate', 'Hard')
PATH_SPEED_KMH = {'Easy': 3.0, 'Moderate': 2.5, 'Hard': 2.0}
# Rough box around Ratnagiri district; rejects points drawn elsewhere.
PATH_BOUNDS = {'lat': (16.3, 18.3), 'lng': (72.8, 74.2)}


class HiddenPath(db.Model):
    __tablename__ = 'hidden_paths'

    id = db.Column(db.Integer, primary_key=True)

    # Public content
    title = db.Column(db.String(200), nullable=False)
    path_type = db.Column(db.String(40), nullable=False)
    difficulty = db.Column(db.String(20), nullable=False)
    taluka = db.Column(db.String(80))
    village = db.Column(db.String(120))
    length_km = db.Column(db.Float)
    duration_min = db.Column(db.Integer)
    best_season = db.Column(db.String(80))
    avoid_season = db.Column(db.String(120))
    open_in_monsoon = db.Column(db.Boolean, default=False)
    how_to_reach = db.Column(db.Text)
    safety_notes = db.Column(db.Text)
    photos = db.Column(db.JSON, default=list)       # Cloudinary URLs, first = cover

    # Route: [[lat, lng], ...], first = start, last = end
    route = db.Column(db.JSON, default=list)
    start_lat = db.Column(db.Float)
    start_lng = db.Column(db.Float)

    # Admin publishing options
    hide_exact_coords = db.Column(db.Boolean, default=False)
    verified_by_dept = db.Column(db.Boolean, default=False)
    locals_pick = db.Column(db.Boolean, default=False)

    # PRIVATE: never returned by public routes
    submitter_role = db.Column(db.String(40))
    submitter_name = db.Column(db.String(120))
    submitter_phone = db.Column(db.String(30))
    submitter_email = db.Column(db.String(120))
    submitter_note = db.Column(db.Text)

    # Review workflow
    status = db.Column(db.String(20), nullable=False, default='pending', index=True)
    admin_note = db.Column(db.Text)
    created_at = db.Column(db.DateTime, default=datetime.utcnow)
    reviewed_at = db.Column(db.DateTime)


# Creates the hidden_paths table on the first request if it does not exist yet,
# so no separate migration is needed.
_hidden_paths_ready = False


@bp.before_app_request
def _ensure_hidden_paths_table():
    global _hidden_paths_ready
    if _hidden_paths_ready:
        return
    _hidden_paths_ready = True
    try:
        HiddenPath.__table__.create(bind=db.engine, checkfirst=True)
    except Exception as e:
        print("HIDDEN PATHS TABLE ERROR:", e)


# ---------------------------------------------------------------- helpers ----

def _haversine_km(lat1, lng1, lat2, lng2):
    r = 6371
    d_lat = math.radians(lat2 - lat1)
    d_lng = math.radians(lng2 - lng1)
    a = (math.sin(d_lat / 2) ** 2
         + math.cos(math.radians(lat1)) * math.cos(math.radians(lat2)) * math.sin(d_lng / 2) ** 2)
    return r * 2 * math.atan2(math.sqrt(a), math.sqrt(1 - a))


def _route_length_km(route):
    return round(sum(_haversine_km(a[0], a[1], b[0], b[1]) for a, b in zip(route, route[1:])), 1)


def _walk_minutes(length_km, difficulty):
    speed = PATH_SPEED_KMH.get(difficulty, 3.0)
    return max(5, int(round(length_km / speed * 60 / 5.0)) * 5)


def _clean(value, max_len):
    return (value or '').strip()[:max_len]


def _parse_route(raw):
    """Returns a clean [[lat, lng], ...] list or None if invalid."""
    if not isinstance(raw, list) or not (2 <= len(raw) <= 300):
        return None
    route = []
    for pt in raw:
        try:
            lat, lng = float(pt[0]), float(pt[1])
        except (TypeError, ValueError, IndexError, KeyError):
            return None
        if not (PATH_BOUNDS['lat'][0] <= lat <= PATH_BOUNDS['lat'][1]
                and PATH_BOUNDS['lng'][0] <= lng <= PATH_BOUNDS['lng'][1]):
            return None
        route.append([round(lat, 6), round(lng, 6)])
    return route


def hidden_path_to_public(p, user_lat=None, user_lng=None):
    """Public shape. No submitter details, ever. Coordinates only if allowed."""
    show_coords = not p.hide_exact_coords and p.start_lat is not None

    distance = None
    if user_lat is not None and user_lng is not None and p.start_lat is not None:
        # Computed here so hidden coordinates never leave the server.
        distance = round(_haversine_km(user_lat, user_lng, p.start_lat, p.start_lng), 1)

    return {
        'id': p.id,
        'title': p.title,
        'path_type': p.path_type,
        'difficulty': p.difficulty,
        'taluka': p.taluka,
        'village': p.village,
        'length_km': p.length_km,
        'duration_min': p.duration_min,
        'best_season': p.best_season,
        'avoid_season': p.avoid_season,
        'open_in_monsoon': bool(p.open_in_monsoon),
        'how_to_reach': p.how_to_reach,
        'safety_notes': p.safety_notes,
        'cover_photo': (p.photos or [None])[0],
        'photos': p.photos or [],
        'verified_by_dept': bool(p.verified_by_dept),
        'locals_pick': bool(p.locals_pick),
        'start_lat': p.start_lat if show_coords else None,
        'start_lng': p.start_lng if show_coords else None,
        'route': (p.route or []) if show_coords else [],
        'distance_km': distance,
    }


def hidden_path_to_admin(p):
    """Everything, including private submitter details and the true route."""
    d = hidden_path_to_public(p)
    d.update({
        'start_lat': p.start_lat,
        'start_lng': p.start_lng,
        'route': p.route or [],
        'hide_exact_coords': bool(p.hide_exact_coords),
        'submitter_role': p.submitter_role,
        'submitter_name': p.submitter_name,
        'submitter_phone': p.submitter_phone,
        'submitter_email': p.submitter_email,
        'submitter_note': p.submitter_note,
        'status': p.status,
        'admin_note': p.admin_note,
        'created_at': p.created_at.isoformat() if p.created_at else None,
        'reviewed_at': p.reviewed_at.isoformat() if p.reviewed_at else None,
    })
    return d


# ---------------------------------------------------------- public routes ----

@bp.route('/api/hidden-paths', methods=['GET'])
def list_hidden_paths():
    """Approved paths only, newest first. Optional ?lat=&lng= adds distance_km."""
    user_lat = request.args.get('lat', type=float)
    user_lng = request.args.get('lng', type=float)
    paths = (HiddenPath.query.filter_by(status='approved')
             .order_by(HiddenPath.created_at.desc()).all())
    return jsonify({
        'success': True,
        'paths': [hidden_path_to_public(p, user_lat, user_lng) for p in paths],
    })


@bp.route('/api/hidden-paths/<int:path_id>', methods=['GET'])
def get_hidden_path(path_id):
    p = HiddenPath.query.filter_by(id=path_id, status='approved').first()
    if not p:
        return jsonify({'success': False, 'error': 'Path not found.'}), 404
    return jsonify({'success': True, 'path': hidden_path_to_public(p)})


@bp.route('/api/hidden-paths/register', methods=['POST'])
def register_hidden_path():
    """Public submission. Always saved as 'pending'; nothing is published until an admin approves."""
    data = request.get_json(silent=True) or {}

    # Honeypot: real users never fill this hidden field.
    if data.get('website'):
        return jsonify({'success': True, 'message': 'Thank you! Your path was submitted for review.'})

    errors = []
    title = _clean(data.get('title'), 200)
    path_type = data.get('path_type')
    difficulty = data.get('difficulty')
    safety_notes = _clean(data.get('safety_notes'), 2000)
    name = _clean(data.get('submitter_name'), 120)
    phone = _clean(data.get('phone_number'), 30)
    email = _clean(data.get('email_address'), 120)
    route = _parse_route(data.get('route'))
    photos = data.get('photos')

    if not title:
        errors.append('Path title is required.')
    if path_type not in PATH_TYPES:
        errors.append('Choose a valid path type.')
    if difficulty not in PATH_DIFFICULTIES:
        errors.append('Choose a valid difficulty.')
    if not safety_notes:
        errors.append('Safety notes are required.')
    if not name:
        errors.append('Your name is required.')
    if not phone and not email:
        errors.append('Give a phone number or an email.')
    if route is None:
        errors.append('Draw the path on the map inside Ratnagiri district (start and end point needed).')
    if data.get('consent_public_land') is not True:
        errors.append('Please confirm the path is on public land or you have the owner\'s permission.')
    if (not isinstance(photos, list) or not (1 <= len(photos) <= 3)
            or not all(isinstance(u, str) and u.startswith('http') for u in photos)):
        errors.append('Add 1 to 3 photos.')

    if errors:
        return jsonify({'success': False, 'error': ' '.join(errors)}), 400

    length_km = _route_length_km(route)

    p = HiddenPath(
        title=title,
        path_type=path_type,
        difficulty=difficulty,
        taluka=_clean(data.get('taluka_name'), 80),
        village=_clean(data.get('village_name'), 120),
        length_km=length_km,
        duration_min=_walk_minutes(length_km, difficulty),
        best_season=_clean(data.get('best_season'), 80),
        avoid_season=_clean(data.get('avoid_season'), 120),
        open_in_monsoon=bool(data.get('open_in_monsoon')),
        how_to_reach=_clean(data.get('how_to_reach'), 2000),
        safety_notes=safety_notes,
        photos=photos,
        route=route,
        start_lat=route[0][0],
        start_lng=route[0][1],
        # "Sensitive place" ticked by the submitter -> start hidden; admin can change it.
        hide_exact_coords=bool(data.get('sensitive')),
        submitter_role=_clean(data.get('user_type'), 40),
        submitter_name=name,
        submitter_phone=phone,
        submitter_email=email,
        submitter_note=_clean(data.get('submitter_note'), 2000),
        status='pending',
    )
    db.session.add(p)
    db.session.commit()

    return jsonify({
        'success': True,
        'message': 'Thank you! Your path was submitted. The tourism department will review it before it is published.',
    }), 201


# ----------------------------------------------------------- admin routes ----

@bp.route('/api/admin/hidden-paths', methods=['GET'])
@admin_required
def admin_list_hidden_paths():
    status = request.args.get('status', 'pending')
    q = HiddenPath.query
    if status in PATH_STATUSES:
        q = q.filter_by(status=status)
    items = q.order_by(HiddenPath.created_at.desc()).all()
    counts = {s: HiddenPath.query.filter_by(status=s).count() for s in PATH_STATUSES}
    return jsonify({'success': True, 'paths': [hidden_path_to_admin(p) for p in items], 'counts': counts})


@bp.route('/api/admin/hidden-paths/<int:path_id>/review', methods=['POST'])
@admin_required
def admin_review_hidden_path(path_id):
    p = HiddenPath.query.get_or_404(path_id)
    data = request.get_json(silent=True) or {}

    action = data.get('action')
    status_for = {'approve': 'approved', 'request_changes': 'needs_changes', 'reject': 'rejected'}
    if action not in status_for:
        return jsonify({'success': False, 'error': 'Unknown action.'}), 400

    note = _clean(data.get('note'), 2000)
    if action != 'approve' and not note:
        return jsonify({'success': False, 'error': 'A note to the submitter is required.'}), 400
    if action == 'approve' and data.get('checklist_complete') is not True:
        return jsonify({'success': False, 'error': 'Complete the review checklist before approving.'}), 400

    p.verified_by_dept = bool(data.get('verified_by_dept'))
    p.locals_pick = bool(data.get('locals_pick'))
    p.hide_exact_coords = bool(data.get('hide_exact_coords'))
    p.status = status_for[action]
    p.admin_note = note
    p.reviewed_at = datetime.utcnow()
    db.session.commit()

    # TODO: if you have email set up, send `note` to p.submitter_email here
    # (needed for "Request changes" and "Reject" to reach the submitter).

    messages = {
        'approve': 'Path approved and published.',
        'request_changes': 'Changes requested.',
        'reject': 'Path rejected.',
    }
    return jsonify({'success': True, 'message': messages[action], 'path': hidden_path_to_admin(p)})


@bp.route('/api/admin/hidden-paths/<int:path_id>', methods=['PUT'])
@admin_required
def admin_update_hidden_path(path_id):
    """Edit the public text of any path (pending or already published)."""
    p = HiddenPath.query.get_or_404(path_id)
    data = request.get_json(silent=True) or {}

    if 'path_type' in data:
        if data['path_type'] not in PATH_TYPES:
            return jsonify({'success': False, 'error': 'Invalid path type.'}), 400
        p.path_type = data['path_type']
    if 'difficulty' in data:
        if data['difficulty'] not in PATH_DIFFICULTIES:
            return jsonify({'success': False, 'error': 'Invalid difficulty.'}), 400
        p.difficulty = data['difficulty']
        if p.length_km:
            p.duration_min = _walk_minutes(p.length_km, p.difficulty)

    text_limits = {
        'title': 200, 'taluka': 80, 'village': 120, 'best_season': 80,
        'avoid_season': 120, 'how_to_reach': 2000, 'safety_notes': 2000,
    }
    for field, limit in text_limits.items():
        if field in data:
            value = _clean(data[field], limit)
            if field in ('title', 'safety_notes') and not value:
                return jsonify({'success': False, 'error': f'{field} cannot be empty.'}), 400
            setattr(p, field, value)
    if 'open_in_monsoon' in data:
        p.open_in_monsoon = bool(data['open_in_monsoon'])

    db.session.commit()
    return jsonify({'success': True, 'path': hidden_path_to_admin(p)})


@bp.route('/api/admin/hidden-paths/<int:path_id>', methods=['DELETE'])
@admin_required
def admin_delete_hidden_path(path_id):
    p = HiddenPath.query.get_or_404(path_id)
    db.session.delete(p)
    db.session.commit()
    return jsonify({'success': True, 'message': 'Path deleted.'})


# ==================================================================
# Local Experiences (Guided Walks / Konkani Food / Community Interaction)
# Requires experiences.sql to have been run on the database first, plus:
#
#   ALTER TABLE experiences
#     ADD COLUMN IF NOT EXISTS images jsonb NOT NULL DEFAULT '[]'::jsonb;
#   UPDATE experiences SET images = jsonb_build_array(image_url)
#     WHERE COALESCE(image_url, '') <> '' AND images = '[]'::jsonb;
#
# Photos are uploaded through your existing POST /api/upload-photo (Cloudinary).
# The first photo in `images` is the cover and is also saved in `image_url`.
# ==================================================================

EXPERIENCE_CATEGORIES = {"guided-walks", "konkani-food", "community-interaction"}
_EXP_TEXT_FIELDS = (
    "title", "summary", "description", "image_url",
    "location", "duration", "price", "season", "contact",
)
_EXP_SELECT = """
    SELECT id, category, title, slug, summary, description, image_url, images,
           location, duration, price, season, highlights, contact,
           display_order, status, updated_at::text AS updated_at
    FROM experiences
"""


def _exp_values(data):
    """Clean the request body into the values the table accepts."""
    values = {f: (data.get(f) or "").strip() for f in _EXP_TEXT_FIELDS}

    highlights = data.get("highlights") or []
    if isinstance(highlights, str):
        highlights = highlights.split("\n")
    values["highlights"] = json.dumps(
        [str(h).strip() for h in highlights if str(h).strip()]
    )

    images = data.get("images") or []
    if isinstance(images, str):
        images = images.split("\n")
    images = [str(u).strip() for u in images if str(u).strip()][:12]
    values["images"] = json.dumps(images)
    if images:
        values["image_url"] = images[0]   # cover stays in sync

    try:
        values["display_order"] = int(data.get("display_order") or 0)
    except (TypeError, ValueError):
        values["display_order"] = 0

    status = data.get("status")
    values["status"] = status if status in ("published", "draft") else "published"
    return values


def _exp_image_problem(values):
    urls = json.loads(values["images"])
    if values["image_url"]:
        urls.append(values["image_url"])
    if any(not u.startswith("https://") for u in urls):
        return "Photo URLs must start with https://"
    return None


# ---------------- Public ----------------

@bp.route('/api/experiences', methods=['GET'])
def list_experiences():
    """/api/experiences?category=guided-walks  (published only)"""
    category = request.args.get("category", "")
    if category not in EXPERIENCE_CATEGORIES:
        return jsonify({"error": "Unknown category."}), 400
    try:
        rows = db.session.execute(text(_EXP_SELECT + """
            WHERE category = :category AND status = 'published'
            ORDER BY display_order, id
        """), {"category": category}).mappings().all()
        return jsonify([dict(r) for r in rows]), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({"error": str(e)}), 500


