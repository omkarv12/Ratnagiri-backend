        db.session.execute(
            text("DELETE FROM tourism_events WHERE id = :id"), {"id": id}
        )
        db.session.commit()
        return jsonify({"success": True, "message": "Event rejected and removed."}), 200
    except Exception as e:
        db.session.rollback()
        return jsonify({"success": False, "error": str(e)}), 500


